{
  "kind": "none",
  "upstream": "maximhq/bifrost",
  "tag_regex": "^transports/v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "tag_prefix": "transports/v",
  "version_file": "flake.nix",
  "version_grep": "version = \"[0-9]+\\.[0-9]+\\.[0-9]+\"",
  "pinned_paths": ["patches"],
  "pinned_flake_regex": "bifrost-src|npmDepsHash|vendorHash|revision =",
  "sync_script": "echo 'bifrost: manual bump; security patches in patches/ are rebased by hand'"
}
